module priority_encoder (
    input  wire [3:0] I,
    output reg  [1:0] Y,
    output reg  Valid
);

always @(*) begin
    Valid = 1'b1;

    casex (I)
        4'b1xxx: Y = 2'b11;   // I3 has highest priority
        4'b01xx: Y = 2'b10;   // I2
        4'b001x: Y = 2'b01;   // I1
        4'b0001: Y = 2'b00;   // I0
        default: begin
            Y = 2'b00;
            Valid = 1'b0;
        end
    endcase
end

endmodule